# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
INTERNAL_ADMIN_API_KEY=replace-with-strong-internal-admin-key
ENABLE_INTERNAL_ROUTES=true
ALLOWED_INGEST_DIR=data
PRIVACY_POLICY_URL=https://api.pillscope.app/privacy
ACCOUNT_DELETION_URL=https://api.pillscope.app/account-deletion

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pillscope
POSTGRES_USER=pillscope
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://pillscope:replace-with-strong-postgres-password@localhost:5432/pillscope

# --- Redis + ARQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@localhost:6379/0

# --- Authentication (JWT) ---
JWT_SECRET_KEY=replace-with-at-least-32-bytes-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM, Embeddings & Reranker ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-base

# --- ML Models & Experiment Tracking ---
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
DDI_MODEL_ARTIFACT_PATH=ml/artifacts/ddi_ensemble.joblib
DDI_ML_MAJOR_THRESHOLD=0.55
DDI_ML_MODERATE_THRESHOLD=0.35

# --- External Datasets & Ingestion Sources ---
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
OPENFDA_ENFORCEMENT_URL=https://api.fda.gov/drug/enforcement.json
OPENFDA_API_KEY=
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
DDINTER_DATA_URL=https://ddinter2.scbdd.com/download/
INDIA_BRAND_CATALOG_PATH=data/raw/india_brands.csv

# --- Observability & Evaluation ---
OTEL_SERVICE_NAME=pillscope-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
